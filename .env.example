# ==========================================
# UPLIFT System Configuration
# ==========================================

# PostgreSQL Database Configuration
DB_USER=postgres
DB_PASSWORD=upliftthesis
DB_HOST=localhost
DB_PORT=5432
DB_NAME=uplift

# Server Host & Port Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173


# ==========================================
# Cloudflare Turnstile Bot Protection
# ==========================================
# Local development uses Cloudflare's official test keys, which always pass:
#   sitekey 1x00000000000000000000AA / secret 1x00000000000000000000000000000000AA
# For production, replace BOTH values with the real key pair of your widget
# (Cloudflare dashboard -> Turnstile -> your widget -> Settings) and set the
# sitekey in frontend/.env as VITE_CLOUDFLARE_TURNSTILE_SITE_KEY.
#
# NEVER commit a real secret: keep it only in the ignored .env file.
#
# Comma-separated allowlist of frontend hostnames whose solved tokens may be
# validated by the backend. Production deployments must list their public
# domain(s); localhost/127.0.0.1 cover local development.
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_HOSTNAMES=localhost,127.0.0.1


