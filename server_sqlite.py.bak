def generate_ai_report(metrics, user_ctx, job_ctx, disability_types):
    """Generates a high-stability analytical report using Context-Question-Answer (CQA) prompting."""
    try:
        primary_cat = disability_types[0].split(" - ")[0] if disability_types else "Physical"
        knowledge = EXPERT_KNOWLEDGE.get(primary_cat, EXPERT_KNOWLEDGE["Physical"])
        job_title = job_ctx.split(" at ")[0] if " at " in job_ctx else job_ctx
        
        def run_stable_model(question, context, max_new=200):
            # CQA Prompting: Most stable format for Flan-T5
            prompt = (
                f"Context: You are a vocational expert. {context} The user is a {user_ctx} and the job is {job_title}.\n"
                f"Question: {question}\n"
                f"Answer:"
            )
            inputs = tokenizer(prompt, return_tensors="pt").to(device)
            # Use high-stability decoding parameters
            outputs = gen_model.generate(
                **inputs, 
                max_new_tokens=max_new, 
                temperature=0.1, # Keep it deterministic to avoid loops
                do_sample=False,
                repetition_penalty=2.5, # Stronger penalty to break 'non-sugar coated' loops
                no_repeat_ngram_size=3, # Strictly prevent 3-word phrase repeats
                early_stopping=True
            )
            res = tokenizer.decode(outputs[0], skip_special_tokens=True).strip()
            # Clean up potential "Answer:" prefix
            return res.replace("Answer:", "").replace("Answer", "").strip()

        # 1. Compatibility
        compatibility = run_stable_model(
            f"Based on the vocational facts, explain in detail why the {job_title} environment is safe for this user.",
            knowledge["analysis"]
        )
        
        # 2. Performance
        performance = run_stable_model(
            f"How will the user perform in the {job_title} role considering their skills and condition?",
            knowledge.get("performance", "Productivity forecast is high.")
        )
        
        # 3. Advice
        advice = run_stable_model(
            f"What are two professional recommendations for workplace ergonomics in this {job_title} position?",
            knowledge.get("advice", "Request ergonomic review.")
        )
        
        # 4. Challenges (Cons)
        challenges = run_stable_model(
            f"What is the single most important challenge or barrier for this user in a {job_title} role?",
            knowledge.get("hinder", "Potential for physical fatigue.")
        )

        # Final quality check to ensure responses aren't too short or missing
        if len(compatibility) < 30: compatibility = knowledge["analysis"]
        if len(performance) < 30: performance = knowledge.get("performance", "Stable productivity forecast.")
        if len(advice) < 30: advice = knowledge.get("advice", "Request ergonomics review.")
        if len(challenges) < 30: challenges = knowledge.get("hinder", "Potential for physical fatigue.")

        return {
            "compatibility": compatibility,
            "performance": performance,
            "advice": advice,
            "challenges": challenges,
            "barriers": knowledge["barriers"]
        }
    except Exception as e:
        print(f"[ERROR] CQA Generation failed: {e}")
        primary_cat = disability_types[0].split(" - ")[0] if disability_types else "Physical"
        knowledge = EXPERT_KNOWLEDGE.get(primary_cat, EXPERT_KNOWLEDGE["Physical"])
        return {
            "compatibility": knowledge["analysis"],
            "performance": knowledge.get("performance", "High productivity forecast."),
            "advice": knowledge.get("advice", "Request ergonomic review."),
            "challenges": knowledge.get("hinder", "Potential for physical fatigue."),
            "barriers": knowledge["barriers"]
        }

